# Youna — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Database (PostgreSQL — Neon, Supabase, Vercel Postgres, or local) ─────
# Format: postgresql://user:password@host:port/dbname?sslmode=require
# For Neon: https://neon.tech → create project → connection string
# For Supabase: Settings → Database → Connection string
# For local: postgresql://postgres:password@localhost:5432/youna?sslmode=disable
DATABASE_URL="postgresql://user:password@localhost:5432/youna?sslmode=require"

# ── NextAuth ────────────────────────────────────────────────────────────────
# A secret used by NextAuth to sign session cookies.
# Generate one: openssl rand -base64 32
# For development, you can use a fixed string; for production, generate a real one.
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ── LLM Providers (optional — Youna works in mock mode without these) ───────
# Added in Phase 3 when you want real LLM responses.
# Uncomment and fill in the one(s) you want to use.

# OpenAI
# OPENAI_API_KEY="sk-..."

# Anthropic (Claude)
# ANTHROPIC_API_KEY="sk-ant-..."

# Google (Gemini)
# GEMINI_API_KEY="AIza..."

# ── Stripe (optional — for subscription billing in Phase 3-4) ──────────────
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ── Plausible Analytics (optional — privacy-friendly, self-hostable) ───────
# PLAUSIBLE_DOMAIN="youna.app"
# PLAUSIBLE_API_KEY="..."

# ── Sentry (optional — error tracking) ─────────────────────────────────────
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
